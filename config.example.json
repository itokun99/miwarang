{
  "backends": {
    "opencode": {
      "type": "opencode-cli",
      "command": "opencode",
      "args": [
        "run"
      ],
      "promptInput": "argument",
      "timeoutMs": 900000
    },
    "commandcode": {
      "type": "command",
      "command": "commandcode",
      "args": [
        "-p",
        "--no-session",
        "--yolo",
        "--max-turns",
        "200",
        "--tools-enable",
        "agent,agent_output",
        "-t"
      ],
      "promptInput": "argument",
      "timeoutMs": 900000,
      "agent": "General"
    },
    "koma": {
      "type": "koma-sdk",
      "command": "koma",
      "args": [
        "sdk",
        "serve"
      ],
      "timeoutMs": 900000
    }
  },
  "delegation": [
    "opencode",
    "commandcode",
    "koma"
  ],
  "runsDirectory": "~/.local/state/miwarang/runs"
}
